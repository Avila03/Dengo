{
  "name": "dengo",
  "version": "2.9.0",
  "description": "Um lugar para cuidar da vida a dois",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:sql": "scripts/test-sql.sh",
    "e2e:build": "NEXT_PUBLIC_SUPABASE_URL= NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= NEXT_PUBLIC_DEMO_MODE=true next build",
    "e2e": "playwright test",
    "e2e:capturas": "playwright test e2e/capturas.spec.ts --project=iphone"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avila03/Dengo.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Avila03/Dengo/issues"
  },
  "homepage": "https://github.com/Avila03/Dengo#readme",
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "private": true
}
